<Layouts.app flash={@flash} current_scope={@current_scope}>

<%!-- Sobrepõe o layout padrão (navbar + max-w-2xl) com a tela full-page industrial --%>
<div class="fixed inset-0 z-50 bg-slate-950 text-slate-100 font-sans antialiased overflow-auto">

  <%!-- ── FUNDO: LOGO PHOENIX COMO MARCA D'ÁGUA ────────────────────────── --%>
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" aria-hidden="true">
    <img src={~p"/images/logo.svg"} class="w-[600px] opacity-[0.03] blur-sm scale-110" />
  </div>

  <%!-- ── CARD DE LOGIN CENTRALIZADO ───────────────────────────────────── --%>
  <main class="relative z-10 flex flex-col items-center justify-center min-h-screen p-6">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-2xl shadow-slate-950/60">

      <%!-- Header do Card --%>
      <div class="border-b border-slate-800 pb-6 mb-8 flex flex-col items-center gap-4">

        <%!-- Logo visível --%>
        <img src={~p"/images/logo.svg"} class="w-12 h-12 opacity-80" />

        <div class="flex items-center gap-3">
          <span class="flex h-3 w-3 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <h1 class="text-xl font-extrabold tracking-tighter text-white uppercase">
            Planta 42 <span class="text-slate-600 font-medium">|</span>
            <span class="text-slate-200">WCore</span>
          </h1>
        </div>

        <p class="text-sm text-slate-400 text-center max-w-sm">
          <%= if @current_scope do %>
            Reautentique-se para continuar.
          <% else %>
            Use suas credenciais de operador para acessar o dashboard de telemetria.
          <% end %>
        </p>
      </div>

      <%!-- Aviso de mailbox local (visível apenas em desenvolvimento) --%>
      <div :if={local_mail_adapter?()} class="mb-6 flex gap-3 items-start bg-sky-950/40 border border-sky-800/50 text-sky-300 text-sm rounded-xl px-4 py-3">
        <.icon name="hero-information-circle" class="size-5 shrink-0 mt-0.5 text-sky-400" />
        <div>
          <p class="font-medium">Modo desenvolvimento ativo.</p>
          <p class="text-sky-400/70">
            Acesse
            <.link href="/dev/mailbox" class="underline hover:text-sky-200 transition-colors">
              a caixa de entrada local
            </.link>
            para ver os links de login.
          </p>
        </div>
      </div>

      <%!-- ── FORMULÁRIO 1: Magic Link (recomendado) ─────────────────────── --%>
      <.form :let={f} for={@form} as={:user} id="login_form_magic" action={~p"/users/log-in"}>
        <div class="space-y-4">
          <div class="space-y-1.5">
            <label class="text-xs text-slate-400 uppercase tracking-wider font-medium">E-mail</label>
            <.input
              readonly={!!@current_scope}
              field={f[:email]}
              type="email"
              placeholder="seu.email@empresa.com.br"
              autocomplete="username"
              spellcheck="false"
              required
              phx-mounted={JS.focus()}
            />
          </div>
          <.button class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-3 rounded-xl transition-all duration-200 text-sm shadow-lg shadow-emerald-950/30">
            Entrar com link por e-mail →
          </.button>
        </div>
      </.form>

      <%!-- Divisor --%>
      <div class="flex items-center gap-3 my-6">
        <div class="flex-1 h-px bg-slate-800"></div>
        <span class="text-xs text-slate-600 uppercase tracking-widest">ou</span>
        <div class="flex-1 h-px bg-slate-800"></div>
      </div>

      <%!-- ── FORMULÁRIO 2: Email + Senha ─────────────────────────────────── --%>
      <.form :let={f} for={@form} as={:user} id="login_form_password" action={~p"/users/log-in"}>
        <div class="space-y-4">
          <div class="space-y-1.5">
            <label class="text-xs text-slate-400 uppercase tracking-wider font-medium">E-mail</label>
            <.input
              readonly={!!@current_scope}
              field={f[:email]}
              type="email"
              placeholder="seu.email@empresa.com.br"
              autocomplete="username"
              spellcheck="false"
              required
            />
          </div>
          <div class="space-y-1.5">
            <label class="text-xs text-slate-400 uppercase tracking-wider font-medium">Senha</label>
            <.input
              field={f[:password]}
              type="password"
              autocomplete="current-password"
              spellcheck="false"
            />
          </div>
          <.button
            class="w-full bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 rounded-xl transition-all duration-200 text-sm"
            name={@form[:remember_me].name}
            value="true"
          >
            Entrar e permanecer logado →
          </.button>
          <.button class="w-full bg-transparent border border-slate-700 hover:border-slate-500 text-slate-300 font-semibold py-3 rounded-xl transition-all duration-200 text-sm">
            Entrar apenas desta vez
          </.button>
        </div>
      </.form>

      <%!-- Footer do Card --%>
      <div class="mt-8 pt-6 border-t border-slate-800 text-center space-y-2">
        <p class="text-sm text-slate-500">Ainda não tem acesso?</p>
        <.link
          navigate={~p"/users/register"}
          class="text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors"
        >
          Registrar nova conta de operador →
        </.link>
      </div>

    </div>

    <%!-- Versão --%>
    <div class="mt-8 text-[10px] text-slate-700 uppercase tracking-widest font-mono">
      WCore Telemetry Engine v0.1.0 · Planta 42
    </div>

  </main>

</div>

</Layouts.app>
